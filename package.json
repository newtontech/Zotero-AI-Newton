{
  "name": "zotero-ai-newton",
  "type": "module",
  "version": "0.0.1-beta",
  "description": "AI workspace for Zotero with Bohrium-style local chat",
  "config": {
    "addonName": "Zotero AI Newton",
    "addonID": "zotero-ai@local",
    "addonRef": "zoteroai",
    "addonInstance": "ZoteroAI",
    "prefsPrefix": "extensions.zotero.zoteroai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newtontech/Zotero-AI-Newton.git"
  },
  "author": "Zotero AI Newton contributors",
  "bugs": {
    "url": "https://github.com/newtontech/Zotero-AI-Newton/issues"
  },
  "homepage": "https://github.com/newtontech/Zotero-AI-Newton#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && mv .scaffold/build/zotero-ai-newton.xpi .scaffold/build/zotero-ai-newton-$npm_package_version.xpi && cp .scaffold/build/zotero-ai-newton-$npm_package_version.xpi release/ && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
